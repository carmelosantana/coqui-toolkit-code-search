{
    "name": "coquibot/coqui-toolkit-code-search",
    "description": "Code search toolkit for Coqui — text search via ripgrep, symbol indexing via ctags, incremental SQLite index",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Carmelo Santana"
        }
    ],
    "keywords": [
        "php-agents",
        "code-search",
        "ripgrep",
        "ctags",
        "symbol-index",
        "coqui",
        "toolkit"
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "carmelosantana/php-agents": "^0.7",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoquiBot\\Toolkits\\CodeSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoquiBot\\Toolkits\\CodeSearch\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "php-agents": {
            "toolkits": [
                "CoquiBot\\Toolkits\\CodeSearch\\CodeSearchToolkit"
            ],
            "description": "Code search — text/regex search via ripgrep, symbol lookup via ctags, incremental SQLite index"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
